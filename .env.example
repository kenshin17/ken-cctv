# Copy to .env and fill in. .env is git-ignored.

# LAN IP of the machine running Docker (the Linux server in production): used for WebRTC
HOST_LAN_IP=192.168.1.10

# Tapo C200 (camera account from the Tapo app, not your TP-Link login)
TAPO_IP=192.168.1.21
TAPO_USER=
TAPO_PASS=

# EZTV: full RTSP URL. Common patterns, try in order:
#   rtsp://admin:PASS@IP:554/ch1/main
#   rtsp://admin:PASS@IP:554/H.264
#   rtsp://admin:PASS@IP:554/live/ch00_0
EZTV_RTSP_URL=rtsp://admin:PASS@192.168.1.22:554/ch1/main
# Sub stream (smaller) for the dashboard grid; go2rtc transcodes it to H.264
EZTV_RTSP_SUB_URL=rtsp://admin:PASS@192.168.1.22:554/ch1/sub
