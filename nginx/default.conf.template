# Rendered by the nginx image at start-up (envsubst): ${NGINX_PORT} and ${GO2RTC_UPSTREAM}
# come from docker-compose. nginx's own $variables are left untouched.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${NGINX_PORT};
  root /usr/share/nginx/html;
  index index.html;

  # Always fetch fresh dashboard files (small)
  add_header Cache-Control "no-cache";

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Only the read-only go2rtc endpoints the dashboard uses. The rest of the go2rtc API
  # (PUT/DELETE streams, config edits, exec sources) must never be reachable from here,
  # since the dashboard may be exposed through an Ingress.
  location /api/ {
    return 403;
  }

  location ~ ^/api/(ws|streams|frame\.jpeg)$ {
    limit_except GET {
      deny all;
    }
    proxy_pass http://${GO2RTC_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  # go2rtc's player script, served from go2rtc so it always matches the server version
  location = /video-rtc.js {
    proxy_pass http://${GO2RTC_UPSTREAM};
  }
}
